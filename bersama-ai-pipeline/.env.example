# ── BersamaAi pipeline environment ──────────────────────────────────────────
# Copy to ".env" and fill in. In GitHub Actions, set each as a repository secret
# (Settings → Secrets and variables → Actions). NEVER commit the real .env.

# [REQUIRED] LLM API key from Zhipu / Z.ai (the summarizer + news judge).
#   Preferred name ZAI_API_KEY; GLM_API_KEY also works as a fallback.
#   China portal:   https://open.bigmodel.cn  -> API Keys
#   International:  https://z.ai             -> API Keys
ZAI_API_KEY=your-zai-key-here

# [OPTIONAL] LLM endpoint. Preferred name ZAI_BASE_URL; GLM_BASE_URL also works.
#   Z.ai "coding" endpoint (used with glm-5.2 subscriptions):
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
#   Standard Z.ai endpoint:        https://api.z.ai/api/paas/v4/
#   China (bigmodel) endpoint:     https://open.bigmodel.cn/api/paas/v4/
# ── Optional tuning ─────────────────────────────────────────────────────────
# LLM model. Preferred name GLM_MODEL; SUMMARY_MODEL also works.
# glm-5.2 = latest/reasoning (strongest, costlier); glm-4.6 = solid + cheaper for 5-pt summaries.
GLM_MODEL=glm-5.2
# Skip videos longer than this (minutes) — saves cost + CI time.
MAX_DURATION_MIN=60
# Whisper audio fallback (v1.1). Leave 0 in v1.
WHISPER_ENABLED=0



# [REQUIRED] Discord webhook for the #curated-resources channel.
# Discord → channel → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# [REQUIRED for news digest] Discord webhook for the #subscription-value channel.
# If unset, the news digest falls back to DISCORD_WEBHOOK_URL (same channel).
DISCORD_NEWS_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Engagement feedback loop (A5) ────────────────────────────────────────────
# [OPTIONAL] Bot token for the engagement sweep — reads reactions on news cards
#   via read-only REST. SAME token as bersama-bot / discord-mcp. Only set this
#   as a GH Actions secret if the repo is PRIVATE (a public-repo leak = full bot
#   admin; Discord tokens aren't scoped). If unset, the sweep exits 0 and the
#   news run is unaffected. Verify repo visibility before adding: gh repo view --json visibility
DISCORD_TOKEN=
# [OPTIONAL] Webhook for #staff-chat — the weekly engagement digest posts here.
DISCORD_STAFF_CHAT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# [OPTIONAL] Engagement actuator kill switch. "false" (default) = the loop only
#   COLLECTS telemetry; posts stay byte-identical to pre-loop. Flip to "true" to
#   let preference scores bias quotas + the judge taste memo (effective only once
#   n_events >= 20; see pipeline/preferences.py MIN_EVENTS).
PREFS_ENABLED=false

# [REQUIRED] Telegram bot that will post to your broadcast channel.
# Create via @BotFather → /newbot → copy the token.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# [REQUIRED] Telegram channel id the bot posts to (bot must be admin of the channel).
# For a public channel you can use @channelname; for private use the -100... id.
TELEGRAM_CHANNEL_ID=@bersamaai

# [REQUIRED for failure alerts] Your personal Telegram chat id (so the bot can DM you
# when a run fails or a video is skipped). Get it from @userinfobot.
TELEGRAM_DM_CHAT_ID=

