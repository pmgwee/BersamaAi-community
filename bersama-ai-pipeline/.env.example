# ── BersamaAi pipeline environment ──────────────────────────────────────────
# Copy to ".env" and fill in. In GitHub Actions, set each as a repository secret
# (Settings → Secrets and variables → Actions). NEVER commit the real .env.
#
# Where each key is needed:
#   [VM]   = the GCP pipeline VM (creator-watch summarizer + on-demand /share)
#   [GH]   = a GitHub Actions secret (news digest + engagement loop run there)
#   [both] = needed in BOTH places

# ── LLM (Z.ai / GLM) — powers the summarizer + the news/share judge ───────────
# [both] REQUIRED. Preferred name ZAI_API_KEY; GLM_API_KEY also works.
#   International: https://z.ai → API Keys · China: https://open.bigmodel.cn
ZAI_API_KEY=
# [both] Z.ai "coding" endpoint (used with glm-5.2 subscriptions):
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
#   Standard Z.ai:    https://api.z.ai/api/paas/v4/
#   China (bigmodel): https://open.bigmodel.cn/api/paas/v4/
# [both] LLM model (glm-5.2 = strongest; glm-4.6 = cheaper for 5-pt summaries).
GLM_MODEL=glm-5.2

# ── ASR (Groq Whisper) — transcribes caption-less videos ─────────────────────
# [VM] REQUIRED for video transcription: the YouTube summarizer's caption-less
#   fallback AND on-demand share of social videos (IG reels / XHS / TikTok) so the
#   card describes what the video actually says (the caption alone is often bait).
#   Free key at https://console.groq.com. Code reads GROQ_API_KEY or GROQ_KEY.
GROQ_API_KEY=
# [VM] optional Whisper model (default whisper-large-v3):
# GROQ_WHISPER_MODEL=whisper-large-v3

# ── News sources ─────────────────────────────────────────────────────────────
# [GH] optional but recommended — authenticated GitHub Trending search (no rate limit):
GITHUB_TOKEN=
# [GH] optional — Reddit OAuth app (script type: https://www.reddit.com/prefs/apps).
#   Restores the full JSON API (real upvote counts on cards). Unset = the engine
#   falls back to Reddit's public .rss feeds (works today, but cards show hot-rank
#   instead of upvotes — reddit.com 403s unauthenticated .json since ~2026-07).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Summarizer tuning ────────────────────────────────────────────────────────
# [VM] skip videos longer than this (minutes) — saves cost + time:
MAX_DURATION_MIN=60
# [VM] legacy toggle (leave 0; ASR is now auto-enabled whenever GROQ_API_KEY is set):
WHISPER_ENABLED=0

# ── Discord webhooks (one per channel the pipeline posts to) ─────────────────
# Get each: Discord → channel → Integrations → Webhooks → New Webhook → Copy URL.
# [VM+GH] #youtube-resources (creator-watch summarizer; was #curated-resources):
DISCORD_YOUTUBE_WEBHOOK_URL=https://discord.com/api/webhooks/...
#   legacy alias (still read as a fallback if only this is set): DISCORD_WEBHOOK_URL
# [VM+GH] #ai-dev-tools (coding news):
DISCORD_DEVTOOLS_WEBHOOK_URL=https://discord.com/api/webhooks/...
#   legacy alias (still read as a fallback if only this is set): DISCORD_NEWS_WEBHOOK_URL
# [VM+GH] creative + research channels (news routing + on-demand /share):
DISCORD_IMAGE_CREATION_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_VIDEO_CREATION_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_VOICE_STUDIO_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_EDUCATION_WEBHOOK_URL=https://discord.com/api/webhooks/...
# [VM+GH] #earn-money-with-ai (finance / fintech / AI-trading news):
DISCORD_FINANCE_WEBHOOK_URL=https://discord.com/api/webhooks/...
# [VM+GH] #stock-invest — @EconomyApp daily digest, read from that account's
#   Bluesky MIRROR via the public AT Protocol API (no key, no cookie, no LLM).
#   The fetch is IP-agnostic, so this runs from the VM cron OR GitHub Actions:
DISCORD_STOCK_INVEST_WEBHOOK_URL=https://discord.com/api/webhooks/...
# [VM+GH] optional x-digest tuning — defaults are fine, neither is a secret:
# X_BSKY_API_BASE=https://public.api.bsky.app  # alternate AT Proto appview
# X_STALE_DAYS=6                               # ⚠️ #staff-chat if the mirror freezes
#   RETIRED: X_RSSHUB_BASE / TWITTER_AUTH_TOKEN. The RSSHub-plus-login-cookie
#   route was abandoned (the cookie expires and the job rots silently) — the
#   Bluesky mirror needs no auth at all. Delete both if your .env still has them.
# [GH] #staff-chat — the weekly engagement digest + news-run health warnings post
#   here (a news run that posts 0 cards sends a ⚠️ so silent runs are visible):
DISCORD_STAFF_CHAT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Engagement feedback loop ─────────────────────────────────────────────────
# [GH] bot token for the engagement sweep (reads reactions via read-only REST).
#   SAME token as the bot / MCP jar. ⚠️ PRIVATE REPO ONLY — a public-repo leak is
#   full bot admin (Discord tokens aren't scoped). If unset, the sweep is skipped
#   (exit 0) and the news run is unaffected. Verify: gh repo view --json visibility
DISCORD_TOKEN=
# [GH] actuator kill switch. "false" (default) = collect telemetry only (byte-identical
#   posts); "true" lets preference scores bias quotas + the judge (after n_events >= 20).
PREFS_ENABLED=false

# ── On-demand HTTP trigger (phone portal) ────────────────────────────────────
# [VM] shared secret in the /run and /share URLs (http://<VM_IP>:8080/?token=…):
ON_DEMAND_TOKEN=

# ── Telegram (summarizer broadcast + failure alerts) ─────────────────────────
# [VM+GH] bot that posts to your broadcast channel (@BotFather → /newbot):
TELEGRAM_BOT_TOKEN=
# [VM+GH] channel id the bot posts to (bot must be admin). @public or -100… private:
TELEGRAM_CHANNEL_ID=@bersamaai
# [VM+GH] your personal chat id for failure DMs (get it from @userinfobot):
TELEGRAM_DM_CHAT_ID=
