# BersamaAi event bot — environment variables.
# Copy this file to ".env" and fill in your values.
# (bot.py auto-loads .env via python-dotenv when you run `python bot.py`.)
#
# The bot runs on its own VM (systemd service `bersama`). Only these keys are
# needed there — channels/roles/levels live in config.json, not the environment.

# Your Discord bot token — the SAME one used by the SaseQ discord-mcp jar
# (Discord allows both processes on one token concurrently). REQUIRED.
DISCORD_TOKEN=paste-your-bot-token-here

# Z.ai API — powers @BersamaAi / !ai replies using GLM-5.2.
# Get a key at https://z.ai (GLM Coding Plan ~US$3/month). Leave ZAI_API_KEY blank
# to disable AI; everything else (leveling, reaction roles, welcome, commands,
# engagement seed reactions) still works.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.2

# [optional] Jina Reader — when a member shares a link and @mentions the bot, this
# fetches the page content so the bot can answer questions about it. Works without a
# key (rate-limited); add one from https://jina.ai/ for higher limits. Leave blank to skip.
JINA_API_KEY=
