# BersamaAi event bot — environment variables.
# Copy this file to ".env" and fill in your values.
# (bot.py auto-loads .env via python-dotenv when you run `python bot.py`.)

# Your Discord bot token — the SAME one used by the SaseQ discord-mcp jar.
# (Discord allows both processes on one token concurrently.)
DISCORD_TOKEN=paste-your-bot-token-here

# Z.ai API — powers @BersamaAi / !ai replies using GLM-5.2.
# Get a key at https://z.ai (GLM Coding Plan ~US$3/month). Leave blank to disable AI;
# everything else (leveling, reaction roles, welcome, commands) still works.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.2
