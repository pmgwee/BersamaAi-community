# BersamaAi event bot — environment variables.
# Copy this file to ".env" and fill in your values.
# (bot.py auto-loads .env via python-dotenv when you run `python bot.py`.)
#
# The bot runs on its own VM (systemd service `bersama`). Only these keys are
# needed there — channels/roles/levels live in config.json, not the environment.

# Your Discord bot token — the SAME one used by the SaseQ discord-mcp jar
# (Discord allows both processes on one token concurrently). REQUIRED.
DISCORD_TOKEN=paste-your-bot-token-here

# LLM API (provider-neutral) — powers @BersamaAi / !ai replies.
# Provider today: OpenCode Go (https://opencode.ai/docs/go/) + grok-4.6 via the
# Responses API. Leave LLM_API_KEY blank to disable AI; everything else (leveling,
# reaction roles, welcome, commands, engagement seed reactions) still works.
# NEVER commit the real key.
LLM_API_KEY=
# Base URL only — the SDK appends "/responses".
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=grok-4.6
# Reasoning depth: low | medium | high | xhigh ("extra high", deepest; default).
# This is the latency knob for member-facing chat — xhigh makes @BersamaAi think
# before replying, so answers are better but take noticeably longer to arrive.
# Drop to "low"/"medium" if replies feel sluggish; "off" removes the parameter.
LLM_REASONING_EFFORT=xhigh

# [optional] Jina Reader — when a member shares a link and @mentions the bot, this
# fetches the page content so the bot can answer questions about it. Works without a
# key (rate-limited); add one from https://jina.ai/ for higher limits. Leave blank to skip.
JINA_API_KEY=
